<mjml>
  <mj-body background-color="#f4f4f4">
    <mj-include path="../partials/header.mjml" />

    <mj-section
      background-color="#ffffff"
      padding="20px 20px"
      border-radius="5px"
    >
      <mj-column>
        <!-- Heading -->
        <mj-text
          font-size="18px"
          color="#151e2f"
          font-weight="bold"
          padding-bottom="10px"
        >
        You've Earned a Discount! 🎉
        </mj-text>

        <!-- Intro -->
        <mj-text
          font-size="15px"
          color="#555555"
          line-height="22px"
          padding-bottom="15px"
        >
          Hello {{ parentName }},<br /><br />
          Great news! As a token of our appreciation, {{ studentName }} has been awarded a special discount on future course and program enrollments with us.
        </mj-text>

        <!-- Details -->
        <mj-table>
          <tr>
            <td style="padding: 8px 0; font-weight: bold; color: #151e2f">
              Student:
            </td>
            <td style="padding: 8px 0; color: #555555">
              {{ studentName }}
            </td>
          </tr>
          <tr>
            <td style="padding: 8px 0; font-weight: bold; color: #151e2f">
              Discount:
            </td>
            <td style="padding: 8px 0; color: #555555">
              {{ discountPercentage }}% off
            </td>
          </tr>
          <tr>
            <td style="padding: 8px 0; font-weight: bold; color: #151e2f">
              Expires On:
            </td>
            <td style="padding: 8px 0; color: #555555">
              {{ expiryDate }}
            </td>
          </tr>
        </mj-table>

        <!-- CTA -->
        <mj-button
          background-color="#1e88e5"
          color="#ffffff"
          font-size="16px"
          font-weight="bold"
          border-radius="5px"
          href="{{ enrollmentUrl }}"
          padding="20px 0"
        >
          Browse Programs & Enroll
        </mj-button>

        <!-- Footer -->
        <mj-text
          font-size="12px"
          color="#999999"
          align="center"
          padding-top="10px"
        >
          This discount is applied automatically at enrollment and cannot be combined with other offers. Contact us if you have any questions.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../partials/footer.mjml" />
  </mj-body>
</mjml>